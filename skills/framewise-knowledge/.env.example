# 帧知 API Key - 在 https://www.framewise.cc/settings 生成
# 方式一（通用，推荐）：设置环境变量
#   export FRAMEWISE_API_KEY="fw_你的密钥"
#
# 方式二（OpenClaw 专用）：编辑 ~/.openclaw/openclaw.json
#   {
#     "skills": {
#       "entries": {
#         "framewise-knowledge": {
#           "enabled": true,
#           "apiKey": "fw_你的密钥"
#         }
#       }
#     }
#   }
FRAMEWISE_API_KEY=fw_你的密钥
